# secrets / env
.env

# ALL local, non-released stuff lives here (scratch, tests, logs, regression
# notes, symlinked indexes, golden copies). Convention: nothing local outside _local/.
_local/

# default output dir when TELLTAIL_OUT_DIR is unset (demo / judge / release land here)
outputs/

# generated / large artifacts (defensive, anywhere)
*.index
*.npy
*.log
*.out
*.err

# python
__pycache__/
.ipynb_checkpoints/

# dev-only demo-data builder (builds BASE corpus; not the shipped enriched one)
demo/_build_data.py

# build artifacts
*.egg-info/
