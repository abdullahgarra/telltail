# Copy to .env and fill in. Paths are resolved ONLY through these variables.

# Corpus and query inputs.
TELLTAIL_DATA_DIR=
# Precomputed FAISS indices (one per retriever).
TELLTAIL_INDEX_DIR=
# Experiment outputs (rankings, scores, figures).
TELLTAIL_OUT_DIR=

# OpenAI embedding API key (only needed for the openai-3-small model).
OPENAI_API_KEY=
# Hugging Face token (only needed for gated models).
HF_TOKEN=
